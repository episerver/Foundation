{
  // Copy this file to appsettings.Development.json and fill in real values.
  // appsettings.Development.json is gitignored — never commit secrets.
  //
  // On Optimizely DXP (PaaS), ConnectionStrings and Optimizely:ContentGraph
  // are injected automatically by the platform — no need to set them here.
  "ConnectionStrings": {
    // SQL Server connection strings for local development.
    // DXP injects these automatically in hosted environments.
    "EPiServerDB": "Server=.;Database=<cms-db-name>;User Id=<db-user>;Password=<db-password>;TrustServerCertificate=True",
    "EcfSqlConnection": "Server=.;Database=<commerce-db-name>;User Id=<db-user>;Password=<db-password>;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Optimizely": {
    // Optimizely Graph credentials — found in the Graph portal (cg.optimizely.com).
    // DXP injects these automatically in hosted environments.
    "ContentGraph": {
      "GatewayAddress": "https://cg.optimizely.com",
      "AppKey": "<graph-app-key>",
      "Secret": "<graph-secret-base64>",
      "SingleKey": "<graph-single-key>"
    },
    "Cmp": {
      // CMP integration credentials — found in Optimizely CMP portal.
      "Client": {
        "ClientId": "<cmp-client-id>",
        "ClientSecret": "<cmp-client-secret>"
      }
    },
    "Cms": {
      "Service": {
        "OauthClients": [
          {
            "AllowActAs": true,
            "ClientId": "cmp_publishing_integration",
            "ClientSecret": "<cmp-publishing-client-secret>",
            "SigningKey": "<cmp-signing-key>"
          }
        ]
      }
    }
  },
  "EPiServer": {
    "OdpVisitorGroupOptions": {
      "OdpEndpoints": [
        {
          "Name": "US",
          "BaseEndPoint": "https://api.zaius.com",
          "PrivateApiKey": "<odp-private-api-key>"
        }
      ]
    }
  },
  "MAIOdpSettings": {
    "OdpBaseEndPoint": "https://api.zaius.com/",
    "CustomerObjectName": "customers",
    "APIKey": "<odp-private-api-key>"
  }
}
