{
  "ConnectionStrings": {
    // On Optimizely DXP these are injected automatically by the platform.
    // For local development, set real values in appsettings.Development.json (gitignored).
    "EPiServerDB": "",
    "EcfSqlConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EPiServer": {
    "OdpVisitorGroupOptions": {
      "OdpCookieName": "vuid",
      "CacheTimeoutSeconds": 1,
      "SchemaCacheTimeoutSeconds": 86400,
      "PopulationEstimateCacheTimeoutSeconds": 4320,
      "OdpEndpoints": [
        {
          "Name": "US",
          "BaseEndPoint": "https://api.zaius.com",
          "PrivateApiKey": "<odp-private-api-key>"
        }
      ]
    },
    "Commerce": {
      "SearchOptions": {
        "DefaultSearchProvider": "LuceneSearchProvider",
        "MaxHitsForSearchResults": 1000,
        "IndexerBasePath": "[appDataPath]/Foundation/SearchIndex",
        "IndexerConnectionString": "",
        "SearchProviders": [
          {
            "Name": "LuceneSearchProvider",
            "Type": "Mediachase.Search.Providers.Lucene.LuceneSearchProvider, Mediachase.Search.LuceneSearchProvider",
            "Parameters": {
              "queryBuilderType": "Mediachase.Search.Providers.Lucene.LuceneSearchQueryBuilder, Mediachase.Search.LuceneSearchProvider",
              "storage": "[appDataPath]/SearchIndex",
              "simulateFaceting": "true"
            }
          }
        ],
        "Indexers": [
          {
            "Name": "catalog",
            "Type": "Mediachase.Search.Extensions.Indexers.CatalogIndexBuilder, Mediachase.Search.Extensions"
          }
        ]
      },
      "MetaDataOptions": {
        "DisableVersionSync": true
      },
      "CatalogOptions": {
        "SalePriceTypes": [
          {
            "Key": "Subscription",
            "Value": "3",
            "Description": "Subscription"
          },
          {
            "Key": "MSRP",
            "Value": "4",
            "Description": "MSRP"
          }
        ]
      }
    },
    "Cms": {
      "ClientGeolocation": {
        "IPAddressHeader": "CF-Connecting-IP"
      }
    },
    "ContentPersonalization": {
      "Environment": "changeme.idio.episerver.net",
      "ClientId": "clientId",
      "ClientName": "clientName",
      "ApiToken": "token"
    },
    "SocialOptions": {
      "settings": {
        "TimeOut": "100000"
      },
      "authentication": {
        "appId": "<social-app-id>",
        "secret": "<social-secret>"
      },
      "endpoints": {
        "ActivityStreams": "https://emea.social.episerver.net:8630/",
        "Comments": "https://emea.social.episerver.net:8769/",
        "Groups": "https://emea.social.episerver.net:8633/",
        "Moderation": "https://emea.social.episerver.net:8509/",
        "Ratings": "https://emea.social.episerver.net:8159/"
      }
    },
    "FormSamples": {
      "FormSamplesApiKeyOptions": {
        "AddressKey": {
          "ClientApiKey": "YOUR_KEY",
          "ServerApiKey": "YOUR_KEY"
        },
        "RecapchaKey": {
          "SiteKey": "YOUR_KEY",
          "SecretKey": "YOUR_KEY"
        }
      }
    },
    "CmsUI": {
      "UIOptions": {
        "WebSocketEnabled": false
      },
      "UploadOptions": {
        "FileSizeLimit": 50000000
      }
    }
  },
  "MAIOdpSettings": {
    "OdpBaseEndPoint": "https://api.zaius.com/",
    "CustomerObjectName": "customers",
    "APIKey": "<odp-private-api-key>"
  },
  "Optimizely": {
    // On Optimizely DXP, ContentGraph values are injected automatically by the platform.
    // For local development, set real values in appsettings.Development.json (gitignored).
    "ContentGraph": {
      "GatewayAddress": "https://cg.optimizely.com",
      "AppKey": "",
      "Secret": "",
      "SingleKey": ""
    },
    "Cmp": {
      "Client": {
        "ClientId": "<cmp-client-id>",
        "ClientSecret": "<cmp-client-secret>"
      }
    },
    "Cms": {
      "Service": {
        "OauthClients": [
          {
            "AllowActAs": true,
            "ClientId": "cmp_publishing_integration",
            "ClientSecret": "<cmp-publishing-client-secret>",
            "SigningKey": "<cmp-signing-key>"
          }
        ]
      }
    }
  }
}
