<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <location path="." inheritInChildApplications="false">
    <system.web xdt:Transform="InsertIfMissing">
      <httpRuntime maxRequestLength="2147483647" xdt:Transform="InsertIfMissing"></httpRuntime>
    </system.web>
    <system.webServer xdt:Transform="InsertIfMissing">
      <security xdt:Transform="InsertIfMissing">
        <requestFiltering xdt:Transform="InsertIfMissing">
          <requestLimits maxAllowedContentLength="4294967295" xdt:Transform="InsertIfMissing" />
        </requestFiltering>
      </security>
      <modules xdt:Transform="InsertIfMissing">
        <remove name="WebDAVModule" xdt:Transform="InsertIfMissing" />
      </modules>
      <handlers>
        <remove name="WebDAV" xdt:Transform="InsertIfMissing" />
      </handlers>
    </system.webServer>
  </location>
</configuration>